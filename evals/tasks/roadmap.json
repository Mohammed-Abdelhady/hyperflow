{
  "id": "roadmap-contract",
  "title": "The roadmap and monorepo boundary contract keep train selection and scope bounded",
  "checks": [
    {
      "type": "files_exist",
      "paths": ["docs/roadmap.md"]
    },
    {
      "type": "read_contains",
      "path": "docs/roadmap.md",
      "value": "## Next trains"
    },
    {
      "type": "read_contains",
      "path": "docs/roadmap.md",
      "value": "## Selection rule for a train"
    },
    {
      "type": "read_not_contains",
      "path": "docs/roadmap.md",
      "value": "scripts/run-evals.py"
    },
    {
      "type": "docs_links_resolve"
    },
    {
      "type": "workspace_boundary",
      "path": "docs/monorepo.md"
    },
    {
      "type": "read_contains",
      "path": "skills/plan/SKILL.md",
      "value": "## Workspace boundary record"
    },
    {
      "type": "read_contains",
      "path": "skills/dispatch/SKILL.md",
      "value": "git diff --name-only"
    }
  ]
}
